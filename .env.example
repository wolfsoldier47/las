# Server
PORT=8080
OPENSHIFT_STAGE=DEV
HTTP_PROXY=
BACKEND_BASE_URL=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ulas
DB_PASSWORD=ulas
DB_NAME=ulas
DB_SSLMODE=disable

# Connection pool
MAXIDLECONNS=10
MAXOPENCONNS=20

APP_CORIA=test

# AAP
ANSIBLEREQUESTTIMEOUT=7200

# Scan job staleness timeout in minutes. Jobs that remain running/initiating longer than this are marked failed.
STALE_SCAN_TIMEOUT=120
AAP_URL=https://aap.example.com
AAP_REST_VERSION=/api/controller/v2/
AAP_USERNAME=
AAP_PASSWORD=
AAP_JOB_TEMPLATE_NAME=jt_400405_ulas_scan

# ServiceNow
SNOW_BASE_URL=
SNOW_USERNAME=
SNOW_PASSWORD=

# JWT authentication
JWT_SECRET_KEY=change-me-in-production-min-32-characters-long
JWT_ACCESS_TOKEN_DURATION=480

# LDAP authentication (leave LDAP_SERVER empty to allow any non-empty username/password in DEV)
LDAP_SERVER=
LDAP_PORT=636
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(cn=%s)
LDAP_GROUP_FILTER=(memberUid=%s)
LDAP_USE_SSL=true
LDAP_SKIP_TLS=true

# Frontend (dev only)
VITE_API_URL=http://localhost:8080/api

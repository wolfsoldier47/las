apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    route.openshift.io/insecureEdgeTerminationPolicy: Redirect
    route.openshift.io/termination: Edge
    # Report downloads (PDF) can take a while to generate for large scans;
    # HAProxy's default route timeout of 30s is not enough.
    haproxy.router.openshift.io/timeout: 300s
  name: {{ include "ulas-service.name" . }}-backend-ingress
spec:
  tls:
    - hosts:
        - {{ .Values.cfg.route_backend_hostname }}
      secretName: {{ include "ulas-service.name" . }}-edge-backend-externalsecret
  rules:
    - host: {{ .Values.cfg.route_backend_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ include "ulas-service.name" . }}-backend-svc
                port:
                  number: {{ .Values.backend.service.port }}

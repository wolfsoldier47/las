---
- name: Enterprise Network Provisioning and Asset Deployment Pipeline
  hosts: localhost
  connection: local
  gather_facts: true
  become: true # Required for system package installation

  vars:
    # 1. System Packages required for the environment
    prerequisite_packages:
      - curl
      - git
      - wget
      - unzip

    # 2. File Download Configurations (Secured with Checksums)
    download_assets:
      - url: "https://hashicorp.com"
        dest: "/tmp/consul_1.15.0_linux_amd64.zip"
        checksum: "sha256:dbe3f3a8b4226d9c66e927c3f3e2efd978a2e5b77ee2d744f4547df1265f2a1b" # Example checksum
      - url: "https://githubusercontent.com"
        dest: "/tmp/network_reference.md"

    # 3. Target Paths for Automation Output
    target_config_dir: "/etc/network_automation"
    target_config_file: "/etc/network_automation/active_routes.conf"

   # 1. Your exact object data schema provided for the interview
    virtualization_config:
      - id: 1
        name: vm1
        active: true
        tags: [compute, development]
      - id: 2
        name: vm2
        active: false
        tags: [compute, production]
      - id: 3
        name: vm3
        active: true
        tags: [network, production]


    configs:
      - id: 1
        name: ab1
        active: true
        tags: [compute, development]
      - id: 2
        name: ab2
        active: false
        tags: [stage, production]
      - id: 3
        name: ab3
        active: true
        tags: [stage, production]
    # Target path configurations
    output_dir: "/etc/virtualization"
    output_file: "/etc/virtualization/inventory_manifest.cfg"

    # 2. Advanced Integrated Jinja2 Template
    inline_inventory_template: |
      # ====================================================================
      # VIRTUALIZATION MANAGEMENT MANIFEST
      # AUTOMATICALLY COMPILED BY ANSIBLE JINJA ENGINE
      # Generated on: {{ ansible_date_time.date }} at {{ ansible_date_time.time }}
      # ====================================================================

      [ACTIVE VIRTUAL MACHINES]
      {% for vm in virtualization_config if vm.active == true %}
      VM Identifier : ID-0{{ vm.id }}
      Machine Name  : {{ vm.name | upper }}
      Assigned Tags : {{ vm.tags | join(', ') }}
      --------------------------------------------------------------------
      {% else %}
      NOTICE: No active virtual machines registered in this cluster block.
      {% endfor %}

      [DECOMMISSIONED / INACTIVE MACHINES]
      {% for vm in virtualization_config if vm.active == false %}
      VM Identifier : ID-0{{ vm.id }}
      Machine Name  : {{ vm.name | upper }}
      Assigned Tags : {{ vm.tags | join(', ') }}
      --------------------------------------------------------------------
      {% endfor %}

      [PRODUCTION NODE AUDIT]
      # Filtering machines containing the 'production' tag across the array
      {% for vm in virtualization_config %}
      {% if 'production' in vm.tags %}
      * Alert Target: {{ vm.name }} (Active Status: {{ vm.active | string | upper }})
      {% endif %}
      {% endfor %}

      # Manifest Summary Metrics
      Total Registered Configurations: {{ virtualization_config | length }}

  tasks:
    - name: Block 1 | System Initialization & Package Management
      block:
        - name: //
          ansible.builtin.apt:
            update_cache: true
            cache_valid_time: 3600
          when: ansible_os_family == "Debian"

        - name: //
          ansible.builtin.package:
            name: "{{ item }}"
            state: present
          loop: "{{ prerequisite_packages }}"
          register: package_install_result

        - name: //
          ansible.builtin.debug:
            msg: "System prerequisites updated. Changed status: {{ package_install_result.changed }}"

    - name: Block 2 | Remote Asset Acquisition Pipeline
      block:
        - name: Fetch remote configuration schema and binaries
          ansible.builtin.get_url:
            url: "{{ item.url }}"
            dest: "{{ item.dest }}"
            mode: '0644'
            timeout: 30
            # Conditionally apply checksum verification if defined in the object
            checksum: "{{ item.checksum | default(omit) }}"
          loop: "{{ download_assets }}"
          register: download_results

        - name: Audit downloaded files
          ansible.builtin.debug:
            msg: "File downloaded to {{ item.dest }} successfully."
          loop: "{{ download_results.results }}"
          when: item.changed

    - name: Block 3 | Directory Structure & Idempotent Template Generation
      block:
        - name: //
          ansible.builtin.file:
            path: "{{ target_config_dir }}"
            state: directory
            owner: root
            group: root
            mode: '0755'

        - name: //
          ansible.builtin.copy:
            content: "{{ inline_inventory_template }}"
            dest: "{{ target_config_file }}"
            owner: root
            group: root
            mode: '0600' # Restricted read/write permissions for security
          register: template_render_result

        - name: //
          ansible.builtin.debug:
            msg: "Configuration successfully compiled at {{ target_config_file }}. State changed: {{ template_render_result.changed }}"

      rescue:
        - name: //
          ansible.builtin.fail:
            msg: "Critical automation pipeline failure encountered. Rollback or human intervention required."

    - name:  Database Query Operation (With Security Flaw)
      block:

        - name: Install database management packages and prerequisites
          ansible.builtin.package:
            name:
              - curl
              - wget
              - python3-pip
              # Standard driver for community MySQL / MariaDB ecosystems
              - python3-pymysql 
            state: present

        
        - name: Fetch detailed telemetry from cluster database using VM name
          community.mysql.mysql_query:
            login_host: "{{ db_host }}"
            login_user: "{{ db_user }}"
            login_password: "{{ db_password }}"
            login_db: "{{ db_name }}"
            query: "SELECT * FROM metrics WHERE vm_name = '{{ input_vm_name }}';"  
          register: db_query_result
          ignore_errors: true # 

        - name: Set fact for template tracking
          ansible.builtin.set_fact:
            last_executed_query: "SELECT * FROM metrics WHERE vm_name = '{{ input_vm_name }}';"

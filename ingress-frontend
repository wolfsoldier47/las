apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    route.openshift.io/insecureEdgeTerminationPolicy: Redirect
    route.openshift.io/termination: Edge
  name: {{ include "ulas-service.name" . }}-ingress
spec:
  tls:
    - hosts:
        - {{ .Values.cfg.route_frontend_hostname }}
      secretName: {{ include "ulas-service.name" . }}-edge-externalsecret
  rules:
    - host: {{ .Values.cfg.route_frontend_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ include "ulas-service.name" . }}-frontend-svc
                port:
                  number: {{ .Values.frontend.service.port }}
